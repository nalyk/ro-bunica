{
  "name": "bunica-playtest",
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "Shared": {
        "$path": "src/shared"
      },
      "PlaytestShared": {
        "$path": "tests/playtest/Shared"
      }
    },
    "ServerScriptService": {
      "Server": {
        "$path": "src/server"
      },
      "Playtest": {
        "$path": "tests/playtest/Server.server.luau"
      }
    },
    "StarterPlayer": {
      "StarterPlayerScripts": {
        "Client": {
          "$path": "src/client"
        },
        "PlaytestClient": {
          "$path": "tests/playtest/Client.client.luau"
        }
      }
    },
    "Players": {
      "$properties": {
        "CharacterAutoLoads": true
      }
    },
    "Lighting": {
      "$properties": {
        "Technology": "ShadowMap"
      }
    },
    "ReplicatedFirst": {
      "Loading": {
        "$path": "src/first"
      }
    },
    "Workspace": {
      "$properties": {
        "StreamingEnabled": true,
        "StreamingTargetRadius": 1024,
        "StreamingMinRadius": 256
      }
    },
    "HttpService": {
      "$properties": {
        "HttpEnabled": true
      }
    }
  }
}
