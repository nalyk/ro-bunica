local AimAssist = require(Shared.Domain.AimAssist)

describe("AimAssist", function()
	it("redirecționează spre ținta din rază", function()
		local result = AimAssist.retarget(Vector3.new(10, 0, 0), { Vector3.new(0, 5, 0) }, 25)
		expect(result).toEqual(Vector3.new(0, 5, 0))
	end)
	it("lasă aruncarea neschimbată în afara razei", function()
		local aim = Vector3.new(100, 0, 0)
		expect(AimAssist.retarget(aim, { Vector3.new(0, 0, 0) }, 25)).toEqual(aim)
	end)
	it("alege ținta cea mai apropiată", function()
		local result =
			AimAssist.retarget(Vector3.new(0, 0, 0), { Vector3.new(20, 0, 0), Vector3.new(5, 0, 0) }, 25)
		expect(result).toEqual(Vector3.new(5, 0, 0))
	end)
	it("ignoră înălțimea la distanță", function()
		local result = AimAssist.retarget(Vector3.new(0, 50, 0), { Vector3.new(3, 0, 0) }, 5)
		expect(result).toEqual(Vector3.new(3, 0, 0))
	end)
end)
