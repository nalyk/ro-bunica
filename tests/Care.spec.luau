local Care = require(Shared.Domain.Care)
local Economy = require(Shared.Domain.Economy)

describe("Care", function()
	it("fericirea de pornire e 60; fericit (≥ 80) = +10% venit; nefericit nu pierde nimic", function()
		expect(Care.happiness({})).toBe(60)
		expect(Care.multiplier(80)).toBe(1.1)
		expect(Care.multiplier(79)).toBe(1)
		expect(Care.multiplier(0)).toBe(1)
	end)
	it("hrana crește fericirea, până la 100", function()
		local record = { happiness = 50 }
		Care.feed(record, "peste")
		expect(record.happiness).toBe(50 + Care.FOOD.peste)
		for _ = 1, 10 do
			Care.feed(record, "placinta")
		end
		expect(record.happiness).toBe(100)
		expect(Care.feed(record, "pietre")).toBe(false)
	end)
	it("mângâierea: o dată la 30 s", function()
		local record = { happiness = 50 }
		expect(Care.pet(record, 100)).toBe(true)
		expect(Care.pet(record, 110)).toBe(false)
		expect(Care.pet(record, 131)).toBe(true)
		expect(record.happiness).toBe(50 + 2 * Care.PET)
	end)
	it("scade cu 1 pe oră de joc, nu sub 0", function()
		local record = { happiness = 10 }
		Care.decay(record, 3600 * 3)
		expect(math.abs(record.happiness - 7) < 1e-9).toBe(true)
		Care.decay(record, 3600 * 30)
		expect(record.happiness).toBe(0)
	end)
	it("venitul unei creaturi fericite e cu 10% mai mare", function()
		local base = Economy.incomePerSecond({ id = "Mamaligator", size = "Normal" })
		local happy = Economy.incomePerSecond({ id = "Mamaligator", size = "Normal", happiness = 90 })
		expect(math.abs(happy - base * 1.1) < 1e-6).toBe(true)
	end)
end)
