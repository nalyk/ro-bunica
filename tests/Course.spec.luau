local Course = require(Shared.Domain.Course)

local GATES = { Vector3.new(0, 0, 0), Vector3.new(0, 0, 30), Vector3.new(20, 0, 60), Vector3.new(0, 0, 90) }

describe("Course", function()
	it("porțile se iau în ordine; o poartă sărită nu contează", function()
		local run = Course.new(GATES, 4, 30, 0)
		expect(Course.update(run, Vector3.new(0, 0, 30), 2)).toBe("gate")
		expect(run.next).toBe(3)
		expect(Course.update(run, Vector3.new(0, 0, 90), 4)).toBe("none") -- a sărit poarta 3
		expect(run.next).toBe(3)
		expect(Course.update(run, Vector3.new(20, 0, 60), 5)).toBe("gate")
		expect(Course.update(run, Vector3.new(0, 0, 90), 7)).toBe("finish")
		expect(run.finishedAt).toBe(7)
	end)
	it("scurtătura (viteză imposibilă între porți) e refuzată: înapoi la ultima poartă", function()
		local run = Course.new(GATES, 4, 30, 0)
		Course.update(run, Vector3.new(0, 0, 30), 2)
		-- 36 studs în 0,2 s = 180 studs/s
		expect(Course.update(run, Vector3.new(20, 0, 60), 2.2)).toBe("cheat")
		expect(run.next).toBe(3)
		expect(Course.respawnPoint(run)).toBe(GATES[2])
	end)
	it("cine iese de pe traseu (mai departe decât culoarul) revine la ultima poartă", function()
		local run = Course.new(GATES, 4, 30, 0)
		Course.update(run, Vector3.new(0, 0, 30), 2)
		expect(Course.update(run, Vector3.new(80, 0, 45), 3)).toBe("off")
		expect(Course.update(run, Vector3.new(5, 0, 40), 3.5)).toBe("none")
	end)
	it("culoarul se măsoară față de traseu, nu față de poartă", function()
		expect(Course.offCourse(GATES, Vector3.new(10, 0, 45), 15)).toBe(false)
		expect(Course.offCourse(GATES, Vector3.new(60, 0, 45), 15)).toBe(true)
	end)
end)
