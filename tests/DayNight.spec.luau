local DayNight = require(Shared.Domain.DayNight)

describe("DayNight", function()
	it("începe cu ziua", function()
		local info = DayNight.at(0)
		expect(info.phase).toBe("Day")
		expect(info.secondsLeft).toBe(240)
	end)
	it("trece în noapte după 4 minute", function()
		local info = DayNight.at(240)
		expect(info.phase).toBe("Night")
		expect(info.secondsLeft).toBe(180)
	end)
	it("ciclul se repetă", function()
		local info = DayNight.at(420 + 10)
		expect(info.phase).toBe("Day")
		expect(info.cycle).toBe(1)
		expect(info.secondsLeft).toBe(230)
	end)
end)
