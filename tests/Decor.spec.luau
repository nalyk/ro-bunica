local Decor = require(Shared.Domain.Decor)
local DecorConfig = require(Shared.Config.Decor)

local function profile()
	return { lei = 10000, decor = {}, ownedDecor = {} }
end

describe("Decor", function()
	it("catalogul are peste 20 de obiecte și 12 sloturi", function()
		expect(#DecorConfig.items >= 20).toBe(true)
		expect(#DecorConfig.slots).toBe(12)
	end)
	it("se cumpără pe lei; fără destui lei nu", function()
		local p = profile()
		expect(Decor.buy(p, "muscate")).toBe(true)
		expect(p.lei).toBe(10000 - Decor.price("muscate"))
		expect(p.ownedDecor.muscate).toBe(1)
		p.lei = 10
		local ok, reason = Decor.canBuy(p, "sperietoare")
		expect(ok).toBe(false)
		expect(reason).toBe("NotEnoughLei")
	end)
	it("se așază doar ce ai, pe un slot de felul potrivit", function()
		local p = profile()
		expect((Decor.canPlace(p, "muscate", "s1"))).toBe(false) -- nu-l ai
		Decor.buy(p, "muscate")
		expect((Decor.canPlace(p, "muscate", "s9"))).toBe(false) -- pe gard: nu
		expect(Decor.place(p, "muscate", "s1")).toBe(true)
		expect(p.decor.s1).toBe("muscate")
		-- o singură bucată: pusă pe alt slot, se mută (nu apare a doua)
		expect(Decor.place(p, "muscate", "s2")).toBe(true)
		expect(p.decor.s1).toBeNil()
		Decor.buy(p, "covorRosu")
		expect(Decor.place(p, "covorRosu", "s9")).toBe(true)
	end)
	it("mutarea pe alt slot eliberează slotul vechi; scoaterea îl golește", function()
		local p = profile()
		Decor.buy(p, "banca")
		Decor.place(p, "banca", "s3")
		expect(Decor.place(p, "banca", "s4")).toBe(true)
		expect(p.decor.s3).toBeNil()
		expect(p.decor.s4).toBe("banca")
		Decor.remove(p, "s4")
		expect(p.decor.s4).toBeNil()
	end)
	it("câte obiecte sunt așezate (pentru titlul „Gospodina”)", function()
		local p = profile()
		Decor.buy(p, "banca")
		Decor.buy(p, "felinar")
		Decor.place(p, "banca", "s3")
		Decor.place(p, "felinar", "s4")
		expect(Decor.placedCount(p)).toBe(2)
	end)
end)
