local Inventory = require(Shared.Domain.Inventory)
local DataTemplate = require(Shared.Config.DataTemplate)
local Migrations = require(Shared.Domain.Migrations)

local function record(profile, id)
	return Inventory.newRecord(profile, 7, id or "CartofelAgent", "Normal", nil)
end

describe("Inventory", function()
	it("uid-urile sunt unice și conțin proprietarul", function()
		local profile = DataTemplate.new()
		local a = record(profile)
		local b = record(profile)
		expect(a.uid).toBe("7-1")
		expect(b.uid).toBe("7-2")
	end)

	it("umple întâi piedestalele, apoi beciul, apoi refuză", function()
		local profile = DataTemplate.new()
		profile.pedestalCount = 1
		profile.cellarCapacity = 1
		expect(Inventory.place(profile, record(profile))).toBe("pedestal")
		expect(Inventory.place(profile, record(profile))).toBe("cellar")
		expect(Inventory.place(profile, record(profile))).toBeNil()
	end)

	it("mută între piedestal și beci", function()
		local profile = DataTemplate.new()
		local r = record(profile)
		local _, key = Inventory.place(profile, r)
		expect(Inventory.moveToCellar(profile, key)).toBe(true)
		expect(profile.pedestals[key]).toBeNil()
		expect(Inventory.findCellar(profile, r.uid)).toBe(1)
		expect(Inventory.moveToPedestal(profile, r.uid, "3")).toBe("3")
		expect(#profile.cellar).toBe(0)
	end)

	it("un piedestal ocupat sau inexistent alege primul liber", function()
		local profile = DataTemplate.new()
		local a = record(profile)
		Inventory.place(profile, a)
		local b = record(profile)
		table.insert(profile.cellar, b)
		expect(Inventory.moveToPedestal(profile, b.uid, "1")).toBe("2")
		local c = record(profile)
		table.insert(profile.cellar, c)
		expect(Inventory.moveToPedestal(profile, c.uid, "99")).toBe("3")
	end)

	it("remove găsește creatura oriunde", function()
		local profile = DataTemplate.new()
		local a = record(profile)
		Inventory.place(profile, a)
		local b = record(profile)
		table.insert(profile.cellar, b)
		expect(Inventory.remove(profile, a.uid).uid).toBe(a.uid)
		expect(Inventory.remove(profile, b.uid).uid).toBe(b.uid)
		expect(Inventory.remove(profile, "nu-exista")).toBeNil()
	end)
end)

describe("Migrations", function()
	it("completează câmpurile lipsă fără să le suprascrie pe cele existente", function()
		local old = { lei = 999, stats = { steals = 4 } }
		local profile = Migrations.reconcile(old)
		expect(profile.lei).toBe(999)
		expect(profile.stats.steals).toBe(4)
		expect(profile.stats.defends).toBe(0)
		expect(profile.bedCount).toBe(4)
		expect(profile.version).toBe(DataTemplate.VERSION)
	end)
end)
