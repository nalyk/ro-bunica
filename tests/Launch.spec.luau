local Launch = require(Shared.Domain.Launch)

describe("Launch", function()
	it("codifică ograda gazdei și recomandarea, scurt", function()
		local text = Launch.encode({ kind = "yard", host = 123456789, referrer = 987654321 })
		expect(text).toBe("k=yard;h=123456789;r=987654321")
		expect(#text <= Launch.MAX_BYTES).toBe(true)
	end)

	it("decodifică ce a codificat", function()
		local data = Launch.decode(Launch.encode({ kind = "clip", host = 42 }))
		expect(data and data.kind).toBe("clip")
		expect(data and data.host).toBe(42)
		expect(data and data.referrer).toBe(nil)
	end)

	it("respinge textul străin, prea lung sau cu valori greșite", function()
		expect(Launch.decode(nil)).toBe(nil)
		expect(Launch.decode("")).toBe(nil)
		expect(Launch.decode("salut")).toBe(nil)
		expect(Launch.decode("k=hack;h=1")).toBe(nil)
		expect(Launch.decode("k=yard;h=-5")).toBe(nil)
		expect(Launch.decode("k=yard;h=1.5")).toBe(nil)
		expect(Launch.decode("k=yard;h=abc")).toBe(nil)
		expect(Launch.decode(string.rep("x", 300))).toBe(nil)
		expect(Launch.decode({ k = "yard" } :: any)).toBe(nil)
	end)

	it("ignoră cheile necunoscute, dar păstrează ce e valid", function()
		local data = Launch.decode("k=yard;h=7;z=ceva")
		expect(data and data.host).toBe(7)
	end)

	it("cine se recomandă singur nu e recomandare", function()
		expect(Launch.referrerFor(Launch.decode("k=yard;h=5;r=5"), 5)).toBe(nil)
		expect(Launch.referrerFor(Launch.decode("k=yard;h=5;r=5"), 9)).toBe(5)
		expect(Launch.referrerFor(nil, 9)).toBe(nil)
	end)
end)
