local MusicClock = require(Shared.Domain.MusicClock)

describe("MusicClock", function()
	local grid = MusicClock.grid(10, 120)
	it("o optime la 120 BPM durează 0,25 s, bucla 16 s", function()
		expect(MusicClock.eighth(grid)).toBeCloseTo(0.25)
		expect(MusicClock.loopLength(grid)).toBeCloseTo(16)
	end)
	it("următoarea măsură respectă avansul minim", function()
		expect(MusicClock.nextBoundary(grid, 10.1, 4)).toBeCloseTo(11)
		expect(MusicClock.nextBoundary(grid, 10.95, 4, 0.1)).toBeCloseTo(12)
		expect(MusicClock.nextBoundary(grid, 11, 4)).toBeCloseTo(11)
	end)
	it("măsura și offsetul în buclă se repetă la 16 s", function()
		expect(MusicClock.barInLoop(grid, 10)).toBe(0)
		expect(MusicClock.barInLoop(grid, 12.5)).toBe(2)
		expect(MusicClock.barInLoop(grid, 26.5)).toBe(0)
		expect(MusicClock.offsetInLoop(grid, 27)).toBeCloseTo(1)
	end)
	it("acordul curent urmează armonia pe măsuri", function()
		local roots = { 0, 0, 2, 0 }
		expect(MusicClock.chordRoot(roots, grid, 12.2)).toBe(2)
		expect(MusicClock.chordRoot(roots, grid, 13.2)).toBe(0)
	end)
	it("cuantizarea: pe șaisprezecime, dar nu mai târziu decât limita", function()
		local at = MusicClock.quantize(grid, 10.01, 0.02, 0.13)
		expect(at).toBeCloseTo(10.125)
		local slow = MusicClock.grid(10, 30) -- șaisprezecimea durează 0,5 s
		expect(MusicClock.quantize(slow, 10.01, 0.02, 0.09)).toBeCloseTo(10.03)
	end)
	it("viteza de redare pentru semitonuri", function()
		expect(MusicClock.speedForSemitones(12)).toBeCloseTo(2)
		expect(MusicClock.speedForSemitones(0)).toBeCloseTo(1)
	end)
end)
