local Mutation = require(Shared.Domain.Mutation)

describe("Mutation", function()
	it("prima mutație se aplică", function()
		expect(Mutation.combine(nil, "Wet")).toBe("Wet")
	end)
	it("una mai bună o înlocuiește", function()
		expect(Mutation.combine("Wet", "Golden")).toBe("Golden")
	end)
	it("una mai slabă nu o înlocuiește", function()
		expect(Mutation.combine("Golden", "Wet")).toBe("Golden")
	end)
	it("mutație necunoscută e ignorată", function()
		expect(Mutation.combine("Wet", "Nimic")).toBe("Wet")
	end)
	it("șansa decide aplicarea", function()
		local result, changed = Mutation.tryApply(nil, "Hail", 0.5, function()
			return 0.9
		end)
		expect(result).toBeNil()
		expect(changed).toBe(false)
		result, changed = Mutation.tryApply(nil, "Hail", 0.5, function()
			return 0.1
		end)
		expect(result).toBe("Hail")
		expect(changed).toBe(true)
	end)
end)
