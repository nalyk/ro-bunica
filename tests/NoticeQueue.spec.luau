local NoticeQueue = require(Shared.Domain.NoticeQueue)
local Notices = require(Shared.Config.Notices)

describe("NoticeQueue", function()
	it("urgentul iese primul, apoi reușitele, ambientul la urmă", function()
		local q = NoticeQueue.new()
		NoticeQueue.push(q, "announce.Hatch", "Ana a eclozat", "ambient", 0)
		NoticeQueue.push(q, "notify.Discovered", "Caiet: Ceapa", "reward", 1)
		NoticeQueue.push(q, "notify.Alarm", "Hoț în ogradă!", "urgent", 2)
		expect((NoticeQueue.pop(q, 3) :: any).priority).toBe("urgent")
		expect((NoticeQueue.pop(q, 3) :: any).priority).toBe("reward")
		expect((NoticeQueue.pop(q, 3) :: any).priority).toBe("ambient")
		expect(NoticeQueue.pop(q, 3)).toBeNil()
	end)
	it("mesajele identice se unesc într-unul cu contor", function()
		local q = NoticeQueue.new()
		for _ = 1, 4 do
			NoticeQueue.push(q, "notify.Alarm", "Hoț în ogradă!", "urgent", 0)
		end
		expect(NoticeQueue.waiting(q)).toBe(1)
		expect((NoticeQueue.pop(q, 0) :: any).count).toBe(4)
	end)
	it("din indicii și din ambient rămâne doar cel mai nou", function()
		local q = NoticeQueue.new()
		NoticeQueue.push(q, "notify.NotNight", "Se fură doar noaptea!", "hint", 0)
		NoticeQueue.push(q, "notify.Shielded", "Ograda e protejată", "hint", 1)
		NoticeQueue.push(q, "announce.Hatch", "A", "ambient", 1)
		NoticeQueue.push(q, "announce.Steal", "B", "ambient", 2)
		expect(NoticeQueue.waiting(q)).toBe(2)
		expect((NoticeQueue.pop(q, 2) :: any).text).toBe("Ograda e protejată")
		expect((NoticeQueue.pop(q, 2) :: any).text).toBe("B")
	end)
	it("mesajele vechi expiră, iar peste capacitate se pierde cel mai puțin important", function()
		local q = NoticeQueue.new(3)
		NoticeQueue.push(q, "notify.NotNight", "indiciu", "hint", 0)
		expect(NoticeQueue.pop(q, 10)).toBeNil() -- indiciul a expirat după 4 s
		NoticeQueue.push(q, "a", "1", "reward", 0)
		NoticeQueue.push(q, "b", "2", "reward", 1)
		NoticeQueue.push(q, "c", "3", "ambient", 2)
		NoticeQueue.push(q, "d", "4", "urgent", 3)
		expect(NoticeQueue.waiting(q)).toBe(3)
		local texts = {}
		while true do
			local item = NoticeQueue.pop(q, 4)
			if not item then
				break
			end
			table.insert(texts, item.text)
		end
		expect(table.concat(texts, ",")).toBe("4,1,2")
	end)
	it("coloanele pot cere doar o plajă de priorități", function()
		local q = NoticeQueue.new()
		NoticeQueue.push(q, "announce.Hatch", "ambient", "ambient", 0)
		NoticeQueue.push(q, "notify.Sold", "reward", "reward", 0)
		expect((NoticeQueue.pop(q, 0, 1, 1) :: any).text).toBe("ambient")
		expect((NoticeQueue.pop(q, 0, 2) :: any).text).toBe("reward")
	end)
	it("durata urmează lungimea textului și scade când așteaptă multe", function()
		local short = NoticeQueue.duration("Hoț!", "urgent", 0)
		local long = NoticeQueue.duration(string.rep("a", 80), "reward", 0)
		expect(short >= 2.6).toBe(true)
		expect(long).toBe(4)
		expect(NoticeQueue.duration(string.rep("a", 80), "reward", 3) < long).toBe(true)
		expect(NoticeQueue.duration(string.rep("a", 200), "hint", 0)).toBe(2.6)
	end)
	it("doar urgentul întrerupe, și doar ce nu e urgent", function()
		local showing = { key = "x", text = "x", priority = "reward", count = 1, at = 0, expires = 9 }
		expect(NoticeQueue.interrupts(showing :: any, "urgent")).toBe(true)
		expect(NoticeQueue.interrupts(showing :: any, "reward")).toBe(false)
		showing.priority = "urgent"
		expect(NoticeQueue.interrupts(showing :: any, "urgent")).toBe(false)
	end)
end)

describe("Notices", function()
	it("clasifică după cheie, cu reguli pentru ce nu e listat", function()
		expect(Notices.priority("notify.Alarm")).toBe("urgent")
		expect(Notices.priority("notify.Sold")).toBe("quiet")
		expect(Notices.priority("notify.NotNight")).toBe("hint")
		expect(Notices.priority("notify.Discovered")).toBe("reward")
		expect(Notices.priority("announce.Hatch")).toBe("ambient")
	end)
end)
