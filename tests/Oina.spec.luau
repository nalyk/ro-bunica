local Oina = require(Shared.Domain.Oina)

describe("Oina", function()
	it("împarte jucătorii în două echipe, pe rând", function()
		local state = Oina.new({ 1, 2, 3, 4, 5 })
		expect(state.team[1]).toBe("A")
		expect(state.team[2]).toBe("B")
		expect(state.team[5]).toBe("A")
		expect(state.batting).toBe("A")
	end)
	it("cursa completă dă un punct echipei la bătaie", function()
		local state = Oina.new({ 1, 2, 3, 4 })
		Oina.score(state, { kind = "run", player = 1 })
		expect(state.points.A).toBe(1)
		Oina.score(state, { kind = "run", player = 2 }) -- B e la prindere: nu contează
		expect(state.points.B).toBe(0)
	end)
	it("alergătorul lovit de cineva de la prindere iese din rundă", function()
		local state = Oina.new({ 1, 2, 3, 4 })
		expect(Oina.score(state, { kind = "hit", player = 1, by = 2 })).toBe(true)
		expect(state.out[1]).toBe(true)
		expect(Oina.score(state, { kind = "hit", player = 3, by = 1 })).toBe(false) -- coechipier: nu
		expect(Oina.score(state, { kind = "run", player = 1 })).toBe(false) -- cel scos nu mai aleargă
		expect(state.points.A).toBe(0)
	end)
	it("schimbul: rolurile se inversează, iar cei scoși revin", function()
		local state = Oina.new({ 1, 2, 3, 4 })
		Oina.score(state, { kind = "hit", player = 1, by = 2 })
		Oina.swap(state)
		expect(state.batting).toBe("B")
		expect(state.out[1]).toBeNil()
	end)
	it("toată echipa la bătaie scoasă: schimb imediat", function()
		local state = Oina.new({ 1, 2, 3, 4 })
		expect(Oina.allOut(state)).toBe(false)
		Oina.score(state, { kind = "hit", player = 1, by = 2 })
		Oina.score(state, { kind = "hit", player = 3, by = 4 })
		expect(Oina.allOut(state)).toBe(true)
	end)
end)
