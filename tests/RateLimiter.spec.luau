local RateLimiter = require(Shared.Domain.RateLimiter)

describe("RateLimiter", function()
	it("permite capacitatea, apoi blochează", function()
		local limiter = RateLimiter.new(3, 1)
		expect(limiter:allow(1, 0)).toBe(true)
		expect(limiter:allow(1, 0)).toBe(true)
		expect(limiter:allow(1, 0)).toBe(true)
		expect(limiter:allow(1, 0)).toBe(false)
	end)
	it("se reîncarcă în timp", function()
		local limiter = RateLimiter.new(1, 2)
		expect(limiter:allow("a", 0)).toBe(true)
		expect(limiter:allow("a", 0.2)).toBe(false)
		expect(limiter:allow("a", 0.6)).toBe(true)
	end)
	it("cheile sunt independente", function()
		local limiter = RateLimiter.new(1, 0)
		expect(limiter:allow(1, 0)).toBe(true)
		expect(limiter:allow(2, 0)).toBe(true)
		expect(limiter:allow(1, 0)).toBe(false)
	end)
end)
