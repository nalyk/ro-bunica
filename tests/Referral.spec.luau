local Referral = require(Shared.Domain.Referral)
local Titles = require(Shared.Domain.Titles)

describe("Referral", function()
	it("doar un jucător nou, adus de altcineva, se leagă de cel care l-a adus", function()
		expect(Referral.canLink({ playSeconds = 30 }, 99, 1)).toBe(true)
		expect(Referral.canLink({ playSeconds = 30, referredBy = 5 }, 99, 1)).toBe(false)
		expect(Referral.canLink({ playSeconds = 30 }, nil, 1)).toBe(false)
		expect(Referral.canLink({ playSeconds = 30 }, 1, 1)).toBe(false)
		expect(Referral.canLink({ playSeconds = Referral.NEW_PLAYER_SECONDS + 1 }, 99, 1)).toBe(false)
	end)

	it("recompensa vine după 10 minute de joc, o singură dată", function()
		expect(Referral.due({ playSeconds = 300, referredBy = 9 })).toBe(false)
		expect(Referral.due({ playSeconds = 600, referredBy = 9 })).toBe(true)
		expect(Referral.due({ playSeconds = 900, referredBy = 9, referralRewarded = true })).toBe(false)
		expect(Referral.due({ playSeconds = 900 })).toBe(false)
	end)

	it("plafonul pe cel care aduce: cel mult 50 de recompense", function()
		expect(Referral.claim(0, 3)).toBe(3)
		expect(Referral.claim(48, 5)).toBe(2)
		expect(Referral.claim(50, 5)).toBe(0)
	end)

	it("titlurile: Gazda satului pentru cine aduce, Musafirul pentru cel adus", function()
		expect(Titles.canUse({ referrals = 1 }, "gazda")).toBe(true)
		expect(Titles.canUse({ welcomed = 1 }, "musafir")).toBe(true)
		expect(Titles.canUse({}, "gazda")).toBe(false)
	end)
end)
