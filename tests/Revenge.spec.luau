local Revenge = require(Shared.Domain.Revenge)

describe("Revenge", function()
	it(
		"victima care fură înapoi aceeași creatură până în zori ia bonusul, o singură dată",
		function()
			local marks = Revenge.new()
			Revenge.mark(marks, 10, 20, "u1", 500)
			expect(Revenge.claim(marks, 10, "u1", 100)).toBe(true)
			expect(Revenge.claim(marks, 10, "u1", 101)).toBe(false)
		end
	)
	it("altcineva decât victima nu ia bonusul", function()
		local marks = Revenge.new()
		Revenge.mark(marks, 10, 20, "u1", 500)
		expect(Revenge.claim(marks, 30, "u1", 100)).toBe(false)
		expect(Revenge.claim(marks, 10, "u1", 100)).toBe(true)
	end)
	it("marcajul expiră, iar zorii le șterg pe toate", function()
		local marks = Revenge.new()
		Revenge.mark(marks, 10, 20, "u1", 500)
		expect(Revenge.claim(marks, 10, "u1", 600)).toBe(false)
		Revenge.mark(marks, 10, 20, "u2", 500)
		Revenge.clear(marks)
		expect(Revenge.claim(marks, 10, "u2", 100)).toBe(false)
	end)
	it("ținta victimei: hoțul cu cel mai recent marcaj activ", function()
		local marks = Revenge.new()
		Revenge.mark(marks, 10, 20, "u1", 500)
		Revenge.mark(marks, 10, 21, "u2", 500)
		expect(Revenge.target(marks, 10, 100)).toBe(21)
		expect(Revenge.target(marks, 99, 100)).toBeNil()
	end)
	it("bonusul e jumătate din prețul de vânzare", function()
		expect(Revenge.bonus(1000)).toBe(500)
		expect(Revenge.bonus(15)).toBe(7)
	end)
end)
