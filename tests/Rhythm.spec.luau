local Rhythm = require(Shared.Domain.Rhythm)

describe("Rhythm", function()
	it("apăsarea pe bătaie: Perfect aproape, Bun puțin mai departe, altfel Ratat", function()
		expect(Rhythm.judge(10, 10.03)).toBe("Perfect")
		expect(Rhythm.judge(10, 9.95)).toBe("Perfect")
		expect(Rhythm.judge(10, 10.14)).toBe("Bun")
		expect(Rhythm.judge(10, 10.4)).toBe("Ratat")
	end)
	it("pista: bătăi crescătoare, cam câte cere tempo-ul, deterministă pe seed", function()
		local a = Rhythm.track(5, 120, 30)
		local b = Rhythm.track(5, 120, 30)
		expect(#a).toBe(#b)
		expect(#a >= 55 and #a <= 80).toBe(true)
		for i = 2, #a do
			expect(a[i] > a[i - 1]).toBe(true)
			expect(a[i]).toBe(b[i])
		end
		expect(a[#a] <= 30).toBe(true)
	end)
	it("bătaia cea mai apropiată de o apăsare", function()
		local beats = { 1, 1.5, 2, 2.5 }
		expect(Rhythm.nearest(beats, 1.6)).toBe(2)
		expect(Rhythm.nearest(beats, 2.4)).toBe(4)
	end)
	it("punctele: Perfect 3, Bun 1, Ratat 0", function()
		expect(Rhythm.points("Perfect")).toBe(3)
		expect(Rhythm.points("Bun")).toBe(1)
		expect(Rhythm.points("Ratat")).toBe(0)
	end)
end)
