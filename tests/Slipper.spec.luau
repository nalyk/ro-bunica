local Slipper = require(Shared.Domain.Slipper)

describe("Slipper muniție", function()
	it("consumă până la zero", function()
		local ammo = Slipper.newAmmo(3, 0)
		expect(Slipper.consume(ammo, 0, 3, 2.5)).toBe(true)
		expect(Slipper.consume(ammo, 0, 3, 2.5)).toBe(true)
		expect(Slipper.consume(ammo, 0, 3, 2.5)).toBe(true)
		expect(Slipper.consume(ammo, 0, 3, 2.5)).toBe(false)
	end)

	it("se reîncarcă câte unul", function()
		local ammo = Slipper.newAmmo(3, 0)
		for _ = 1, 3 do
			Slipper.consume(ammo, 0, 3, 2.5)
		end
		Slipper.updateAmmo(ammo, 2.4, 3, 2.5)
		expect(ammo.ammo).toBe(0)
		Slipper.updateAmmo(ammo, 2.5, 3, 2.5)
		expect(ammo.ammo).toBe(1)
		Slipper.updateAmmo(ammo, 100, 3, 2.5)
		expect(ammo.ammo).toBe(3)
	end)

	it("cu muniția plină, reîncărcarea pornește de la prima aruncare", function()
		local ammo = Slipper.newAmmo(3, 0)
		Slipper.consume(ammo, 50, 3, 2.5)
		Slipper.updateAmmo(ammo, 51, 3, 2.5)
		expect(ammo.ammo).toBe(2)
		Slipper.updateAmmo(ammo, 52.5, 3, 2.5)
		expect(ammo.ammo).toBe(3)
	end)
end)

describe("Slipper balistică", function()
	it("traiectoria ajunge în țintă", function()
		local origin = Vector3.new(0, 5, 0)
		local target = Vector3.new(40, 3, 30)
		local velocity = Slipper.launchVelocity(origin, target, 90, 40, 120)
		local flightTime = (target - origin).Magnitude / 90
		local landed = Slipper.positionAt(origin, velocity, 40, flightTime)
		expect((landed - target).Magnitude).toBeLessThan(0.01)
	end)

	it("ținta e limitată la raza maximă", function()
		local origin = Vector3.new(0, 0, 0)
		local velocity = Slipper.launchVelocity(origin, Vector3.new(500, 0, 0), 90, 0, 120)
		local flightTime = 120 / 90
		local landed = Slipper.positionAt(origin, velocity, 0, flightTime)
		expect(landed.X).toBeCloseTo(120, 1e-3)
	end)

	it("distanța la segment", function()
		local a = Vector3.new(0, 0, 0)
		local b = Vector3.new(10, 0, 0)
		expect(Slipper.segmentDistance(a, b, Vector3.new(5, 3, 0))).toBeCloseTo(3)
		expect(Slipper.segmentDistance(a, b, Vector3.new(-4, 3, 0))).toBeCloseTo(5)
	end)

	it("lovitura ține cont de raze", function()
		local a = Vector3.new(0, 0, 0)
		local b = Vector3.new(10, 0, 0)
		expect(Slipper.hits(a, b, Vector3.new(5, 4, 0), 2.5, 2)).toBe(true)
		expect(Slipper.hits(a, b, Vector3.new(5, 5, 0), 2.5, 2)).toBe(false)
	end)
end)
